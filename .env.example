# Environment variables for docker-compose.yml / docker-compose.build.yml.
# Copy this file to .env and adjust the values; .env is gitignored.
#   cp .env.example .env
# Every variable below is optional - the value shown is the default that the
# compose files fall back to when the variable is unset.

# External MySQL (not part of the compose stack).
# host.docker.internal resolves to the host machine; use a hostname or IP when
# the database lives elsewhere.
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=jeecg-boot
MYSQL_USERNAME=root
MYSQL_PASSWORD=root

# External Redis (not part of the compose stack).
# Leave REDIS_PASSWORD empty when the instance requires no authentication.
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

# Host port published for the admin frontend; the container always listens on 80.
# The API port is fixed at 8080:8080 in docker-compose.yml.
WEB_ADMIN_PORT=8807
