# Environment variables for docker-compose.yml, docker-compose.build.yml and
# docker-compose.infra.yml.
# Copy this file to .env and adjust the values; .env is gitignored.
#   cp .env.example .env
# Every variable below is optional - the value shown is the default that the
# compose files fall back to when the variable is unset.
#
# This is the OFFICIAL-SOURCES variant: npm and Maven dependencies are fetched
# from registry.npmjs.org and repo.maven.apache.org. On a mainland-China network
# those are slow enough that a build can look like it has hung, so copy the
# mirror variant instead - same keys, same values, only the two source URLs and
# these notes differ:
#   cp .env.example.cn .env
# Both files must always declare the same set of keys; see "Package sources" at
# the bottom and `pnpm check:env` for the check that enforces it.

# Compose project name. It prefixes the names compose generates for images and
# for any resource that does not set an explicit `name:`, and it is the key
# compose uses to decide which containers belong to this stack. Without it
# compose falls back to the lower-cased directory name, so cloning into a
# differently named folder would silently rename the whole project.
# Must be lower-case: compose rejects capitals in a project name.
# Note that compose v2.0.0 does not support the top-level `name:` key in the
# YAML files ("Additional property name is not allowed"), which is why the
# project name is set here instead.
COMPOSE_PROJECT_NAME=marsquakes

# MySQL. host.docker.internal resolves to the host machine; use a hostname or
# IP when the database lives elsewhere.
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=jeecg-boot
MYSQL_USERNAME=root
MYSQL_PASSWORD=root

# Redis. Leave REDIS_PASSWORD empty when the instance requires no
# authentication.
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

# Host port published for the admin frontend; the container always listens on 80.
# The API port is fixed at 8080:8080 in docker-compose.yml.
WEB_ADMIN_PORT=8807

# --- Base services (docker-compose.infra.yml) -------------------------------
# The settings above assume MySQL and Redis run outside the stack. When you
# start them from docker-compose.infra.yml instead, swap the two hosts for the
# in-network service names - otherwise api keeps resolving
# host.docker.internal and silently ignores the containers just started.
#
#   MYSQL_HOST=mysql
#   MYSQL_PORT=3306
#   REDIS_HOST=redis
#   REDIS_PORT=6379
#
# MYSQL_PASSWORD doubles as the root password of the MySQL container, and
# REDIS_PASSWORD enables --requirepass when it is not empty.
#
# Host ports published by the base services. They default to the standard
# 3306 / 6379 so existing connection strings and IDE data sources work
# untouched. Change them only when the host already has a MySQL or Redis
# bound to those ports - the in-network ports stay 3306 and 6379 regardless.
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379

# Persistence source for the base services. Leave unset to use the Docker
# named volumes (jeecg_boot_mysql_data / jeecg_boot_redis_data). Set a
# relative path to bind-mount a host directory instead, e.g.
#   MYSQL_DATA_SOURCE=./data/mysql
#   REDIS_DATA_SOURCE=./data/redis
# The `mars init` wizard writes these only when you choose host directories;
# ./data is gitignored. Switching an already-populated source starts empty, so
# the init scripts re-run (bind) or the old volume is simply left behind.
# MYSQL_DATA_SOURCE=
# REDIS_DATA_SOURCE=

# --- Package sources (build time only) --------------------------------------
# Where the image builds download npm packages and Maven dependencies from.
# This file uses the official registries, so a clean checkout behaves the same
# on every network. For a mainland-China network use .env.example.cn instead; it
# declares exactly the same keys and differs only in the two values below.
#
# These are build-time values, so they only reach the build through
# `build.args` in docker-compose.build.yml. Two consequences:
#   - Changing them has no effect on an already-built image; rebuild it.
#   - A bare `docker build` does not read this file at all. Use
#     `docker compose -f docker-compose.build.yml build`, or
#     `mars build --platform <p> --docker`, which reads these keys and forwards
#     them as --build-arg.
#
# NPM_REGISTRY only governs where packages are *downloaded* from. It cannot
# override a `tarball:` URL already pinned inside a pnpm lockfile, because the
# builds run `pnpm install --frozen-lockfile`. Keep the lockfiles free of
# `tarball:` fields (see AGENTS.md) or this setting silently does nothing.
NPM_REGISTRY=https://registry.npmjs.org
MAVEN_MIRROR_URL=https://repo.maven.apache.org/maven2
