{
  "name": "marsquakes",
  "version": "1.0.0",
  "private": true,
  "description": "Marsquakes - 多平台项目",
  "author": "Shing Rui <sunquakes@outlook.com>",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "init": "node scripts/init.js",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean",
    "init:web": "cd apps/web && pnpm install",
    "init:web-admin": "cd apps/web-admin && pnpm install",
    "init:android": "cd apps/android && gradlew --version",
    "init:desktop": "cd apps/desktop && pnpm install",
    "dev:web": "turbo dev --filter=web",
    "dev:web-admin": "turbo dev --filter=web-admin",
    "dev:android": "cd apps/android && gradlew installDebug",
    "dev:desktop": "cd apps/desktop && pnpm tauri dev",
    "dev:docs": "pnpm -C docs dev",
    "build:web": "turbo build --filter=web",
    "build:web-admin": "turbo build --filter=web-admin",
    "build:android": "cd apps/android && gradlew assembleRelease",
    "build:desktop": "cd apps/desktop && pnpm tauri build",
    "build:docs": "pnpm -C docs build"
  },
  "devDependencies": {
    "turbo": "^2.4.0"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "volta": {
    "node": "20.20.2"
  }
}