  "home.quickstart.title": {
    "message": "快速开始"
  },
  "home.quickstart.lead": {
    "message": "前置条件只有 Node 22.12.0 及以上和 pnpm。五条命令，从零到项目跑起来。"
  },
  "home.quickstart.step1.title": {
    "message": "安装工具"
  },
  "home.quickstart.step1.description": {
    "message": "先装好 pnpm，然后全局安装一次 mars 命令行工具。"
  },
  "home.quickstart.step2.title": {
    "message": "创建项目"
  },
  "home.quickstart.step2.description": {
    "message": "mars create 会询问你需要哪些端，只复制这些端。"
  },
  "home.quickstart.step3.title": {
    "message": "进入项目目录"
  },
  "home.quickstart.step3.description": {
    "message": "之后所有命令都在新项目文件夹里运行。"
  },
  "home.quickstart.step4.title": {
    "message": "安装所需依赖"
  },
  "home.quickstart.step4.description": {
    "message": "一条 pnpm install 就把整个工作区一次性装好。"
  },
  "home.quickstart.step5.title": {
    "message": "开始开发"
  },
  "home.quickstart.step5.description": {
    "message": "mars dev 会启动所有启用的端；启用原生端时会用到它们各自的工具链。"
  },
