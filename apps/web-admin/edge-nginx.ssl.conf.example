# Edge reverse proxy with HTTPS — copy to edge-nginx.ssl.conf, replace
# admin.example.com with your domain, then mount this file in place of
# edge-nginx.conf and publish host ports 80 and 443 (see docker.md).
#
# Requirements for the nginx container:
#   - port 443 published on the host (the firewall must allow 80 and 443)
#   - the host directory apps/web-admin/certs (git-ignored) mounted
#     read-only at /etc/nginx/certs, containing fullchain.pem and
#     privkey.pem in PEM format (unencrypted private key)
#   - the domain's A record pointing at this host's public IP
#
#   /               -> web-admin container (static SPA; its own nginx also
#                      handles the history-mode fallback)
#   /marsquakes-api/ -> backend API, rewritten to the /marsquakes-api context path
# Both upstreams are resolved at runtime through the embedded Docker DNS, so
# nginx still starts when the other containers are not up yet.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Plain HTTP: only used for the first test and the redirect to HTTPS.
server {
    listen 80;
    server_name admin.example.com;

    return 301 https://$host$request_uri;
}

# HTTPS entry point.
server {
    listen 443 ssl;
    server_name admin.example.com;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    resolver 127.0.0.11 valid=10s ipv6=off;

    client_max_body_size 100m;

    # Backend API (incl. WebSocket for message push, online users, etc.)
    location /marsquakes-api/ {
        set $marsquakes_api marsquakes-api;
        rewrite ^/marsquakes-api/?(.*)$ /marsquakes-api/$1 break;
        proxy_pass       http://$marsquakes_api:8817;
        proxy_redirect   off;
        proxy_set_header Host marsquakes-api;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
    }

    # Admin frontend (static files served by the web-admin nginx)
    location / {
        set $web_admin marsquakes-web-admin;
        proxy_pass       http://$web_admin:80;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    access_log /var/log/nginx/access.log;
}
